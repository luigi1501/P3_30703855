<%- include('../../partials/header', { title: 'Clientes Registrados | Admin' }) %>
<%- include('../../partials/navbar') %>

<div class="admin-container">
    <div class="admin-page-header">
        <div>
            <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800;">Clientes Registrados</h1>
            <p style="color: var(--text-muted);">Total de cuentas de usuarios registrados: <%= usuarios.length %></p>
        </div>
        <div class="admin-header-actions">
            <a href="/admin/dashboard" class="btn-secondary-sm"><i class="fa-solid fa-arrow-left"></i> Volver al Dashboard</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre Completo</th>
                    <th>Correo Electrónico</th>
                    <th>Rol</th>
                </tr>
            </thead>
            <tbody>
                <% if (usuarios && usuarios.length > 0) { %>
                    <% usuarios.forEach(user => { %>
                        <tr>
                            <td>#<%= user.id %></td>
                            <td style="font-weight: 600; color: #fff;"><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td>
                                <span class="badge-cat" style="position: static;"><%= user.role || 'user' %></span>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            No hay usuarios registrados en el sistema.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>
