<%- include('../../partials/header', { title: 'Nueva Imagen | Admin' }) %>
<%- include('../../partials/navbar') %>

<div class="admin-container">
    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
        <a href="/admin/images" class="btn-secondary-sm"><i class="fa-solid fa-arrow-left"></i> Volver</a>
        <div>
            <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.8rem; font-weight: 800;">Nueva Imagen</h1>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Sube un archivo o introduce una URL externa</p>
        </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error" style="max-width: 680px; margin-bottom: 1.5rem;"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
    <% } %>

    <form action="/admin/images/insert" method="POST" enctype="multipart/form-data" style="max-width: 680px;">

        <!-- Cloudinary Status Badge -->
        <div style="margin-bottom: 1.5rem; padding: 0.65rem 1rem; border-radius: var(--radius-sm); background: <%= cloudinaryConfigured ? 'rgba(16,185,129,0.12)' : 'rgba(245,158,11,0.12)' %>; border: 1px solid <%= cloudinaryConfigured ? 'rgba(16,185,129,0.35)' : 'rgba(245,158,11,0.35)' %>; font-size: 0.85rem;">
            <i class="fa-solid fa-<%= cloudinaryConfigured ? 'cloud-arrow-up' : 'triangle-exclamation' %>" style="color: <%= cloudinaryConfigured ? '#10b981' : '#f59e0b' %>;"></i>
            <% if (cloudinaryConfigured) { %>
                <strong style="color:#10b981;">Cloudinary activo</strong> — Puedes subir archivos directamente a la nube.
            <% } else { %>
                <strong style="color:#f59e0b;">Cloudinary no configurado</strong> — Solo se aceptan URLs externas. Agrega las variables en <code>.env</code>.
            <% } %>
        </div>

        <!-- Drag & Drop Upload Zone -->
        <% if (cloudinaryConfigured) { %>
        <div class="upload-zone" id="uploadZone">
            <input type="file" id="imagenFile" name="imagen_file" accept="image/jpeg,image/png,image/webp,image/gif" style="display: none;">
            <div class="upload-zone-content" id="uploadContent">
                <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2.5rem; color: var(--primary); margin-bottom: 0.75rem;"></i>
                <p style="font-weight: 700; color: #fff; margin-bottom: 0.25rem;">Arrastra tu imagen aquí</p>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">o haz clic para seleccionar</p>
                <button type="button" class="btn-secondary-sm" onclick="document.getElementById('imagenFile').click()">
                    <i class="fa-solid fa-folder-open"></i> Elegir archivo
                </button>
                <p style="color: var(--text-muted); font-size: 0.75rem; margin-top: 0.75rem;">JPG, PNG, WebP, GIF — máx. 5MB</p>
            </div>
            <div class="upload-preview" id="uploadPreview" style="display: none;">
                <img id="previewImg" src="" alt="Preview" style="max-height: 180px; border-radius: var(--radius-sm); object-fit: contain;">
                <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem; justify-content: center;">
                    <span id="previewName" style="color: var(--text-muted); font-size: 0.85rem;"></span>
                    <button type="button" class="btn-logout" onclick="clearPreview()" style="font-size: 0.8rem; padding: 0.2rem 0.5rem;">
                        <i class="fa-solid fa-xmark"></i> Cambiar
                    </button>
                </div>
            </div>
        </div>

        <div style="text-align: center; color: var(--text-muted); font-size: 0.85rem; margin: 1rem 0; position: relative;">
            <span style="background: var(--bg-card); padding: 0 1rem; position: relative; z-index: 1;">— o usa una URL —</span>
            <hr style="position: absolute; top: 50%; left: 0; right: 0; border-color: var(--border-glass); margin: 0;">
        </div>
        <% } %>

        <!-- URL Manual -->
        <div class="input-group" style="margin-bottom: 1.25rem;">
            <label for="url">URL de Imagen Externa</label>
            <input type="url" id="url" name="url" class="form-control"
                placeholder="https://ejemplo.com/imagen.jpg"
                oninput="previewUrl(this.value)">
            <small style="color: var(--text-muted); font-size: 0.78rem; margin-top: 4px; display: block;">
                Si subes un archivo, esta URL se ignora.
            </small>
        </div>

        <!-- Producto -->
        <div class="input-group" style="margin-bottom: 1.25rem;">
            <label for="producto_id">Producto</label>
            <select id="producto_id" name="producto_id" class="form-control" required>
                <option value="">— Selecciona un producto —</option>
                <% producto.forEach(p => { %>
                    <option value="<%= p.id %>"><%= p.name %> (ID: <%= p.id %>)</option>
                <% }); %>
            </select>
        </div>

        <!-- Destacado -->
        <div class="input-group" style="margin-bottom: 2rem;">
            <label for="destacado">Imagen Destacada</label>
            <select id="destacado" name="destacado" class="form-control">
                <option value="NO">No</option>
                <option value="SI">Sí (imagen principal)</option>
            </select>
        </div>

        <button type="submit" class="btn-primary-sm btn-block" style="height: 48px; font-size: 1.05rem; justify-content: center;">
            <i class="fa-solid fa-cloud-arrow-up"></i> Guardar Imagen
        </button>
    </form>
</div>

<script>
    // Drag & Drop
    const zone = document.getElementById('uploadZone');
    const fileInput = document.getElementById('imagenFile');

    if (zone && fileInput) {
        zone.addEventListener('click', (e) => {
            if (!e.target.closest('button')) fileInput.click();
        });

        zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file) setPreviewFile(file);
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files[0]) setPreviewFile(fileInput.files[0]);
        });
    }

    function setPreviewFile(file) {
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById('previewImg').src = e.target.result;
            document.getElementById('previewName').textContent = file.name;
            document.getElementById('uploadContent').style.display = 'none';
            document.getElementById('uploadPreview').style.display = 'block';
            // Limpiar URL manual al elegir archivo
            document.getElementById('url').value = '';
        };
        reader.readAsDataURL(file);

        // Asignar archivo al input real
        const dt = new DataTransfer();
        dt.items.add(file);
        if (fileInput) fileInput.files = dt.files;
    }

    function clearPreview() {
        document.getElementById('previewImg').src = '';
        document.getElementById('previewName').textContent = '';
        document.getElementById('uploadContent').style.display = 'block';
        document.getElementById('uploadPreview').style.display = 'none';
        if (fileInput) fileInput.value = '';
    }

    function previewUrl(url) {
        if (url && url.startsWith('http')) clearPreview();
    }
</script>

<style>
.upload-zone {
    border: 2px dashed var(--border-glass);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    background: rgba(15, 23, 42, 0.4);
    margin-bottom: 0;
}
.upload-zone:hover, .upload-zone.drag-over {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
}
.upload-zone.drag-over {
    transform: scale(1.01);
}
</style>

<%- include('../../partials/footer') %>
