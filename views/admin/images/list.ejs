<%- include('../../partials/header', { title: 'Galería de Imágenes | Admin' }) %>
<%- include('../../partials/navbar') %>

<div class="admin-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800;">Galería de Imágenes</h1>
            <p style="color: var(--text-muted);">Total de imágenes registradas: <%= imagen.length %></p>
        </div>
        <div style="display: flex; gap: 1rem;">
            <a href="/admin/dashboard" class="btn-secondary-sm"><i class="fa-solid fa-arrow-left"></i> Volver al Dashboard</a>
            <a href="/insertima" class="btn-primary-sm"><i class="fa-solid fa-plus"></i> Nueva Imagen</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Vista Previa</th>
                    <th>URL de Imagen</th>
                    <th>ID Producto</th>
                    <th>Destacado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (imagen && imagen.length > 0) { %>
                    <% imagen.forEach(item => { %>
                        <tr>
                            <td>#<%= item.id %></td>
                            <td>
                                <img src="<%= item.url %>" alt="Preview" style="width: 50px; height: 50px; object-fit: cover; border-radius: var(--radius-sm);" onerror="this.src='https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=100'">
                            </td>
                            <td style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-muted);"><%= item.url %></td>
                            <td><code>#<%= item.producto_id %></code></td>
                            <td>
                                <span class="<%= item.destacado === 'SI' ? 'badge-condition' : '' %>"><%= item.destacado %></span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="/editima/<%= item.id %>" class="btn-secondary-sm" style="padding: 0.35rem 0.65rem;" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    <a href="/deleteima/<%= item.id %>" class="btn-logout" style="padding: 0.35rem 0.65rem;" onclick="return confirm('¿Estás seguro de eliminar esta imagen?');" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            No hay imágenes registradas en el sistema.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>
