<%- include('../partials/header', { title: 'Acceso Administrativo | Keyboards Store' }) %>
<%- include('../partials/navbar') %>

<main class="main-container">
    <div class="auth-wrapper">
        <div class="auth-header">
            <i class="fa-solid fa-user-shield brand-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem; color: #c084fc;"></i>
            <h2>Panel Administrativo</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Acceso exclusivo para administradores del sistema</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-error">
                <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="input-group">
                <label for="user">Usuario Admin</label>
                <input type="text" id="user" name="user" class="form-control" placeholder="admin" required>
            </div>
            <div class="input-group">
                <label for="pass">Contraseña Admin</label>
                <input type="password" id="pass" name="pass" class="form-control" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-primary-sm btn-block" style="justify-content: center; background: linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%);">
                <i class="fa-solid fa-lock-open"></i> Acceder al Panel
            </button>
        </form>
    </div>
</main>

<%- include('../partials/footer') %>
