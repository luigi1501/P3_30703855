<%- include('../../partials/header', { title: 'Nuevo Producto | Admin' }) %>
<%- include('../../partials/navbar') %>

<main class="main-container">
    <div class="auth-wrapper" style="max-width: 680px;">
        <div class="auth-header">
            <i class="fa-solid fa-keyboard brand-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem; color: var(--primary);"></i>
            <h2>Agregar Nuevo Producto</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Registro completo: asigna categoría e imagen en un solo paso</p>
        </div>

        <form action="/admin/products/insert" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="form-grid-2">
                <div class="input-group">
                    <label for="code">Código del Producto</label>
                    <input type="number" id="code" name="code" class="form-control" placeholder="101" required>
                </div>
                <div class="input-group">
                    <label for="name">Nombre del Producto</label>
                    <input type="text" id="name" name="name" class="form-control" placeholder="Ej. Keychron K2 Wireless" required>
                </div>
            </div>

            <div class="form-grid-2">
                <div class="input-group">
                    <label for="brand">Marca</label>
                    <input type="text" id="brand" name="brand" class="form-control" placeholder="Ej. Keychron" required>
                </div>
                <div class="input-group">
                    <label for="model">Modelo</label>
                    <input type="text" id="model" name="model" class="form-control" placeholder="Ej. K2-V2" required>
                </div>
            </div>

            <div class="input-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                    <label for="category_id" style="margin-bottom: 0;">Categoría del Producto</label>
                    <button type="button" class="btn-secondary-sm" onclick="openQuickCatModal()" style="padding: 0.25rem 0.65rem; font-size: 0.8rem; height: auto;">
                        <i class="fa-solid fa-plus"></i> Nueva Categoría
                    </button>
                </div>
                <select id="category_id" name="category_id" class="form-control" required>
                    <option value="">— Selecciona una categoría —</option>
                    <% if (typeof category !== 'undefined' && category) { %>
                        <% category.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="input-group">
                <label for="price">Precio ($ USD)</label>
                <input type="number" step="0.01" id="price" name="price" class="form-control" placeholder="99.99" required>
            </div>

            <!-- Sección de Imagen Integrada -->
            <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--border-glass); border-radius: var(--radius-md); padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
                <h4 style="color: #fff; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; margin: 0;">
                    <i class="fa-solid fa-image" style="color: #38bdf8;"></i> Imagen del Producto (Opcional)
                </h4>

                <% if (typeof cloudinaryConfigured !== 'undefined' && cloudinaryConfigured) { %>
                    <div class="input-group">
                        <label for="imagen_file">Subir Archivo de Imagen (Cloudinary)</label>
                        <input type="file" id="imagen_file" name="imagen_file" class="form-control" accept="image/*" style="padding: 0.4rem;">
                    </div>
                <% } %>

                <div class="input-group">
                    <label for="image_url">o URL Externa de Imagen</label>
                    <input type="url" id="image_url" name="image_url" class="form-control" placeholder="https://images.unsplash.com/photo-1587829741301-dc798b83add3">
                </div>

                <div class="input-group">
                    <label for="destacado">Marcar como Imagen Principal/Destacada</label>
                    <select id="destacado" name="destacado" class="form-control">
                        <option value="SI">Sí (Imagen Principal)</option>
                        <option value="NO">No</option>
                    </select>
                </div>
            </div>

            <div class="input-group">
                <label for="description">Descripción Detallada</label>
                <textarea id="description" name="description" class="form-control" rows="3" placeholder="Especificaciones del teclado, switches, materiales..." required></textarea>
            </div>

            <div class="responsive-btn-group" style="margin-top: 0.5rem;">
                <a href="/admin/products" class="btn-secondary-sm" style="padding: 0.75rem;"><i class="fa-solid fa-arrow-left"></i> Cancelar</a>
                <button type="submit" class="btn-primary-sm" style="padding: 0.75rem;"><i class="fa-solid fa-save"></i> Guardar Producto Completo</button>
            </div>
        </form>
    </div>
</main>

<!-- Modal Rápido de Nueva Categoría -->
<div id="quickCatModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 420px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <button type="button" class="modal-close-btn" onclick="closeQuickCatModal()">&times;</button>
        <div style="text-align: center;">
            <i class="fa-solid fa-tags" style="font-size: 2rem; color: #38bdf8; margin-bottom: 0.5rem;"></i>
            <h3 style="color: #fff; font-size: 1.2rem; margin-bottom: 0.25rem;">Crear Nueva Categoría</h3>
            <p style="color: var(--text-muted); font-size: 0.82rem;">Se agregará instantáneamente a la lista de categorías</p>
        </div>

        <div class="input-group">
            <label for="new_cat_name">Nombre de Categoría</label>
            <input type="text" id="new_cat_name" class="form-control" placeholder="Ej. Keycaps PBT, Switches..." autocomplete="off">
        </div>

        <div id="quickCatAlert" style="display: none; font-size: 0.82rem; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm);"></div>

        <div class="responsive-btn-group">
            <button type="button" class="btn-secondary-sm" onclick="closeQuickCatModal()">Cancelar</button>
            <button type="button" class="btn-primary-sm" onclick="submitQuickCategory()"><i class="fa-solid fa-check"></i> Guardar</button>
        </div>
    </div>
</div>

<script>
    function openQuickCatModal() {
        document.getElementById('new_cat_name').value = '';
        document.getElementById('quickCatAlert').style.display = 'none';
        document.getElementById('quickCatModal').classList.add('active');
        document.getElementById('new_cat_name').focus();
    }

    function closeQuickCatModal() {
        document.getElementById('quickCatModal').classList.remove('active');
    }

    async function submitQuickCategory() {
        const nameInput = document.getElementById('new_cat_name');
        const alertEl = document.getElementById('quickCatAlert');
        const name = nameInput.value.trim();

        if (!name) {
            alertEl.style.display = 'block';
            alertEl.className = 'alert-error';
            alertEl.innerText = 'Por favor ingresa un nombre para la categoría.';
            return;
        }

        try {
            const res = await fetch('/api/categories/quick-create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });

            const data = await res.json();
            if (data.success) {
                // Agregar al selector dinámicamente y seleccionar
                const select = document.getElementById('category_id');
                const opt = document.createElement('option');
                opt.value = data.category.id;
                opt.textContent = data.category.name;
                opt.selected = true;
                select.appendChild(opt);

                closeQuickCatModal();
            } else {
                alertEl.style.display = 'block';
                alertEl.className = 'alert-error';
                alertEl.innerText = data.message || 'Error al guardar.';
            }
        } catch (err) {
            console.error('Error quick cat:', err);
            alertEl.style.display = 'block';
            alertEl.className = 'alert-error';
            alertEl.innerText = 'Error de conexión con el servidor.';
        }
    }
</script>

<%- include('../../partials/footer') %>
