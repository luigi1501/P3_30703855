<%- include('../../partials/header', { title: 'Nuevo Producto | Admin' }) %>
<%- include('../../partials/navbar') %>

<main class="main-container">
    <div class="auth-wrapper" style="max-width: 600px;">
        <div class="auth-header">
            <i class="fa-solid fa-plus brand-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;"></i>
            <h2>Agregar Producto</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Ingresa los datos para registrar un nuevo producto en el catálogo</p>
        </div>

        <form action="/admin/products/insert" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="input-group">
                <label for="code">Código del Producto</label>
                <input type="number" id="code" name="code" class="form-control" placeholder="101" required>
            </div>

            <div class="input-group">
                <label for="name">Nombre del Producto</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Ej. Keychron K2 Wireless" required>
            </div>

            <div class="input-group">
                <label for="brand">Marca</label>
                <input type="text" id="brand" name="brand" class="form-control" placeholder="Ej. Keychron" required>
            </div>

            <div class="input-group">
                <label for="model">Modelo</label>
                <input type="text" id="model" name="model" class="form-control" placeholder="Ej. K2-V2" required>
            </div>

            <div class="input-group">
                <label for="category_id">Categoría</label>
                <select id="category_id" name="category_id" class="form-control" required>
                    <option value="">Selecciona una categoría</option>
                    <% if (typeof category !== 'undefined' && category) { %>
                        <% category.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="input-group">
                <label for="price">Precio ($)</label>
                <input type="number" step="0.01" id="price" name="price" class="form-control" placeholder="99.99" required>
            </div>

            <div class="input-group">
                <label for="description">Descripción Detallada</label>
                <textarea id="description" name="description" class="form-control" rows="4" placeholder="Especificaciones del teclado..." required></textarea>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <a href="/admin/products" class="btn-secondary-sm" style="flex: 1; justify-content: center;">Cancelar</a>
                <button type="submit" class="btn-primary-sm" style="flex: 1; justify-content: center;"><i class="fa-solid fa-save"></i> Guardar Producto</button>
            </div>
        </form>
    </div>
</main>

<%- include('../../partials/footer') %>
