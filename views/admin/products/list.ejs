<%- include('../../partials/header', { title: 'Gestión de Productos | Admin' }) %>
<%- include('../../partials/navbar') %>

<div class="admin-container">
    <div class="admin-page-header">
        <div>
            <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800;">Catálogo de Productos</h1>
            <p style="color: var(--text-muted);">Total de registros: <%= producto.length %></p>
        </div>
        <div class="admin-header-actions">
            <a href="/admin/dashboard" class="btn-secondary-sm"><i class="fa-solid fa-arrow-left"></i> Volver al Dashboard</a>
            <button type="button" class="btn-primary-sm" onclick="openCreateProductModal()"><i class="fa-solid fa-plus"></i> Nuevo Producto (Modal)</button>
            <a href="/insert" class="btn-secondary-sm"><i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir Página</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (producto && producto.length > 0) { %>
                    <% producto.forEach(item => { %>
                        <tr>
                            <td>#<%= item.id %></td>
                            <td><code><%= item.code %></code></td>
                            <td style="font-weight: 600; color: #fff;"><%= item.name %></td>
                            <td><%= item.brand %></td>
                            <td><%= item.model %></td>
                            <td style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-muted);"><%= item.description %></td>
                            <td style="color: #38bdf8; font-weight: 700;">$<%= Number(item.price).toFixed(2) %></td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="/edit/<%= item.id %>" class="btn-secondary-sm" style="padding: 0.35rem 0.65rem;" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    <a href="/delete/<%= item.id %>" class="btn-logout" style="padding: 0.35rem 0.65rem;" onclick="return confirm('¿Estás seguro de eliminar este producto?');" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                            No hay productos registrados en el sistema.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- All-in-One Modal: Nuevo Producto (Producto + Categoría Rápida + Imagen) -->
<div id="modalCreateProduct" class="modal-overlay">
    <div class="modal-container" style="max-width: 650px; max-height: 90vh; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <button type="button" class="modal-close-btn" onclick="closeCreateProductModal()">&times;</button>
        <div style="text-align: center;">
            <i class="fa-solid fa-keyboard brand-icon" style="font-size: 2.2rem; margin-bottom: 0.25rem; color: var(--primary);"></i>
            <h2 style="color: #fff; font-size: 1.4rem; margin-bottom: 0.25rem;">Nuevo Producto Todo en Uno</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem;">Registra el producto, crea su categoría al instante e incluye su imagen principal</p>
        </div>

        <form action="/admin/products/insert" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="form-grid-2">
                <div class="input-group">
                    <label for="m_code">Código</label>
                    <input type="number" id="m_code" name="code" class="form-control" placeholder="101" required>
                </div>
                <div class="input-group">
                    <label for="m_name">Nombre del Producto</label>
                    <input type="text" id="m_name" name="name" class="form-control" placeholder="Ej. Razer BlackWidow" required>
                </div>
            </div>

            <div class="form-grid-2">
                <div class="input-group">
                    <label for="m_brand">Marca</label>
                    <input type="text" id="m_brand" name="brand" class="form-control" placeholder="Ej. Razer" required>
                </div>
                <div class="input-group">
                    <label for="m_model">Modelo</label>
                    <input type="text" id="m_model" name="model" class="form-control" placeholder="Ej. V4 Pro" required>
                </div>
            </div>

            <div class="input-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                    <label for="m_category_id" style="margin-bottom: 0;">Categoría</label>
                    <button type="button" class="btn-secondary-sm" onclick="openQuickCatModal()" style="padding: 0.2rem 0.5rem; font-size: 0.78rem; height: auto;">
                        <i class="fa-solid fa-plus"></i> Nueva Categoría
                    </button>
                </div>
                <select id="m_category_id" name="category_id" class="form-control" required>
                    <option value="">— Selecciona una categoría —</option>
                    <% if (typeof category !== 'undefined' && category) { %>
                        <% category.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="input-group">
                <label for="m_price">Precio ($ USD)</label>
                <input type="number" step="0.01" id="m_price" name="price" class="form-control" placeholder="129.99" required>
            </div>

            <!-- Imagen adjunta -->
            <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid var(--border-glass); border-radius: var(--radius-md); padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
                <label style="color: #fff; font-size: 0.88rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-image" style="color: #38bdf8;"></i> Adjuntar Imagen al Producto
                </label>

                <% if (typeof cloudinaryConfigured !== 'undefined' && cloudinaryConfigured) { %>
                    <div class="input-group">
                        <label for="m_imagen_file" style="font-size: 0.75rem;">Subir Archivo de Imagen</label>
                        <input type="file" id="m_imagen_file" name="imagen_file" class="form-control" accept="image/*" style="padding: 0.35rem;">
                    </div>
                <% } %>

                <div class="input-group">
                    <label for="m_image_url" style="font-size: 0.75rem;">URL Externa de Imagen</label>
                    <input type="url" id="m_image_url" name="image_url" class="form-control" placeholder="https://images.unsplash.com/photo-1587829741301-dc798b83add3">
                </div>
            </div>

            <div class="input-group">
                <label for="m_description">Descripción</label>
                <textarea id="m_description" name="description" class="form-control" rows="3" placeholder="Detalles del producto..." required></textarea>
            </div>

            <div class="responsive-btn-group" style="margin-top: 0.5rem;">
                <button type="button" class="btn-secondary-sm" onclick="closeCreateProductModal()">Cancelar</button>
                <button type="submit" class="btn-primary-sm"><i class="fa-solid fa-check"></i> Registrar Producto Completo</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Rápido de Nueva Categoría -->
<div id="quickCatModal" class="modal-overlay" style="z-index: 2500;">
    <div class="modal-container" style="max-width: 420px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <button type="button" class="modal-close-btn" onclick="closeQuickCatModal()">&times;</button>
        <div style="text-align: center;">
            <i class="fa-solid fa-tags" style="font-size: 2rem; color: #38bdf8; margin-bottom: 0.5rem;"></i>
            <h3 style="color: #fff; font-size: 1.2rem; margin-bottom: 0.25rem;">Crear Nueva Categoría</h3>
            <p style="color: var(--text-muted); font-size: 0.82rem;">Se agregará instantáneamente a la lista de categorías</p>
        </div>

        <div class="input-group">
            <label for="new_cat_name">Nombre de Categoría</label>
            <input type="text" id="new_cat_name" class="form-control" placeholder="Ej. Keycaps PBT, Switches..." autocomplete="off">
        </div>

        <div id="quickCatAlert" style="display: none; font-size: 0.82rem; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm);"></div>

        <div class="responsive-btn-group">
            <button type="button" class="btn-secondary-sm" onclick="closeQuickCatModal()">Cancelar</button>
            <button type="button" class="btn-primary-sm" onclick="submitQuickCategory()"><i class="fa-solid fa-check"></i> Guardar</button>
        </div>
    </div>
</div>

<script>
    function openCreateProductModal() {
        document.getElementById('modalCreateProduct').classList.add('active');
    }

    function closeCreateProductModal() {
        document.getElementById('modalCreateProduct').classList.remove('active');
    }

    function openQuickCatModal() {
        document.getElementById('new_cat_name').value = '';
        document.getElementById('quickCatAlert').style.display = 'none';
        document.getElementById('quickCatModal').classList.add('active');
        document.getElementById('new_cat_name').focus();
    }

    function closeQuickCatModal() {
        document.getElementById('quickCatModal').classList.remove('active');
    }

    async function submitQuickCategory() {
        const nameInput = document.getElementById('new_cat_name');
        const alertEl = document.getElementById('quickCatAlert');
        const name = nameInput.value.trim();

        if (!name) {
            alertEl.style.display = 'block';
            alertEl.className = 'alert-error';
            alertEl.innerText = 'Por favor ingresa un nombre para la categoría.';
            return;
        }

        try {
            const res = await fetch('/api/categories/quick-create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });

            const data = await res.json();
            if (data.success) {
                // Actualizar todos los selectores de categorías en la página
                const selectors = ['category_id', 'm_category_id'];
                selectors.forEach(id => {
                    const select = document.getElementById(id);
                    if (select) {
                        const opt = document.createElement('option');
                        opt.value = data.category.id;
                        opt.textContent = data.category.name;
                        opt.selected = true;
                        select.appendChild(opt);
                    }
                });

                closeQuickCatModal();
            } else {
                alertEl.style.display = 'block';
                alertEl.className = 'alert-error';
                alertEl.innerText = data.message || 'Error al guardar.';
            }
        } catch (err) {
            console.error('Error quick cat:', err);
            alertEl.style.display = 'block';
            alertEl.className = 'alert-error';
            alertEl.innerText = 'Error de conexión con el servidor.';
        }
    }
</script>

<%- include('../../partials/footer') %>
