<%- include('../partials/header', { title: 'Iniciar Sesión | Keyboards Store' }) %>
<%- include('../partials/navbar') %>

<main class="main-container">
    <div class="auth-wrapper">
        <div class="auth-header">
            <i class="fa-solid fa-circle-user brand-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;"></i>
            <h2>Iniciar Sesión</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Ingresa tus credenciales para acceder a tu cuenta</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-error">
                <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <form action="/pageini" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="input-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="tu@email.com" required>
            </div>
            <div class="input-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>
            
            <button type="submit" class="btn-primary-sm btn-block" style="justify-content: center;">
                <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
            </button>
        </form>

        <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <a href="/password" style="color: var(--primary); font-weight: 500;">¿Olvidaste tu contraseña?</a>
            <p>¿No tienes cuenta? <a href="/register" style="color: #fff; font-weight: 600; text-decoration: underline;">Regístrate gratis</a></p>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
