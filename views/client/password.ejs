<%- include('../partials/header', { title: 'Recuperar Contraseña | Keyboards Store' }) %>
<%- include('../partials/navbar') %>

<main class="main-container">
    <div class="auth-wrapper">
        <div class="auth-header">
            <i class="fa-solid fa-key brand-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;"></i>
            <h2>Recuperar Contraseña</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Ingresa tu correo para recibir las instrucciones</p>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert-success">
                <i class="fa-solid fa-circle-check"></i> <%= message %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-error">
                <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <form action="/recuperar" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="input-group">
                <label for="email">Correo Electrónico Registrado</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="tu@email.com" required>
            </div>

            <button type="submit" class="btn-primary-sm btn-block" style="justify-content: center;">
                <i class="fa-solid fa-paper-plane"></i> Enviar Enlace
            </button>
        </form>

        <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-muted);">
            <a href="/userini" style="color: #fff; font-weight: 600;"><i class="fa-solid fa-arrow-left"></i> Volver a Iniciar Sesión</a>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
