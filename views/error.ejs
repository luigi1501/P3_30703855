<%- include('./partials/header', { title: (typeof error !== 'undefined' && error.status ? error.status : '500') + ' | Error en Keyboards Store' }) %>
<%- include('./partials/navbar') %>

<main class="main-container">
    <div class="auth-wrapper" style="max-width: 720px; text-align: center;">
        <div style="margin-bottom: 1.5rem;">
            <% if (typeof error !== 'undefined' && error.status === 404) { %>
                <i class="fa-solid fa-ghost" style="font-size: 4rem; color: #38bdf8; margin-bottom: 1rem;"></i>
                <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 4rem; font-weight: 800; color: #38bdf8; margin: 0;">404</h1>
                <h2 style="font-size: 1.5rem; font-weight: 700; color: #fff; margin-top: 0.5rem;">Página no encontrada</h2>
                <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem;">La ruta solicitada no existe o ha sido movida.</p>
            <% } else { %>
                <i class="fa-solid fa-triangle-exclamation" style="font-size: 4rem; color: #ef4444; margin-bottom: 1rem;"></i>
                <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 4rem; font-weight: 800; color: #ef4444; margin: 0;"><%= typeof error !== 'undefined' && error.status ? error.status : '500' %></h1>
                <h2 style="font-size: 1.5rem; font-weight: 700; color: #fff; margin-top: 0.5rem;"><%= typeof message !== 'undefined' ? message : 'Ocurrió un error inesperado' %></h2>
                <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem;">Se produjo una falla al procesar tu solicitud.</p>
            <% } %>
        </div>

        <% if (typeof error !== 'undefined' && error.stack) { %>
            <div style="text-align: left; background: rgba(15, 23, 42, 0.9); border: 1px solid var(--border-glass); padding: 1.25rem; border-radius: var(--radius-sm); margin-bottom: 2rem; overflow-x: auto;">
                <h4 style="font-size: 0.85rem; color: #f87171; text-transform: uppercase; margin-bottom: 0.5rem;"><i class="fa-solid fa-bug"></i> Stack Trace (Modo Desarrollo):</h4>
                <pre style="color: #94a3b8; font-family: monospace; font-size: 0.8rem; line-height: 1.5; white-space: pre-wrap;"><%= error.stack %></pre>
            </div>
        <% } %>

        <div style="display: flex; justify-content: center; gap: 1rem;">
            <a href="/" class="btn-primary-sm" style="padding: 0.75rem 1.5rem; font-size: 1rem;"><i class="fa-solid fa-house"></i> Volver al Catálogo</a>
            <a href="/userini" class="btn-secondary-sm" style="padding: 0.75rem 1.5rem; font-size: 1rem;"><i class="fa-solid fa-user"></i> Mi Cuenta</a>
        </div>
    </div>
</main>

<%- include('./partials/footer') %>
